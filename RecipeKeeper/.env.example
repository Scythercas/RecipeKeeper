# Web版(Supabase)専用。ネイティブアプリはこれらを使わない。
# Supabaseプロジェクト設定 > API から値を取得し、.env としてコピーして使うこと。
# .env はgitignore対象(anon keyは公開前提の値だが、念のため生値はコミットしない)。
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# パスワード再設定メールのリンク先(末尾スラッシュなし)。実運用ではGitHub PagesのURL
EXPO_PUBLIC_SITE_URL=https://scythercas.github.io/RecipeKeeper
